# Copy this to the server (wherever this repo is checked out) as .env —
# never commit the real file. docker-compose.yml reads it for ${VAR}
# substitution.

DB_PASSWORD=""
GHCR_OWNER="johnkhasan"

# Full public URL the app is served at, e.g. "https://app.yourdomain.uz"
# or "https://nasiya.hsbch.uz" if sharing a server (see DEPLOY.md).
AUTH_URL=""
# openssl rand -base64 32
AUTH_SECRET=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Only used by docker-compose.override.yml (shared-nginx deployments) —
# the Docker network name of the project whose nginx already owns 80/443.
SHARED_INGRESS_NETWORK=""
