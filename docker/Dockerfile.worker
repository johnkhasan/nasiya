# syntax=docker/dockerfile:1

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

FROM deps AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN npx prisma generate
COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker
CMD ["npx", "tsx", "worker/reminder-cron.ts"]
